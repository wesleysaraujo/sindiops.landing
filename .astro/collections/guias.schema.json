{
  "$ref": "#/definitions/guias",
  "definitions": {
    "guias": {
      "type": "object",
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 15,
          "maxLength": 90
        },
        "resumo": {
          "type": "string",
          "minLength": 70,
          "maxLength": 200
        },
        "respostaCurta": {
          "type": "string",
          "minLength": 80,
          "maxLength": 400
        },
        "frente": {
          "type": "string",
          "enum": [
            "convencao",
            "orcamento",
            "contrato"
          ]
        },
        "publicadoEm": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "revisadoEm": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "revisadoPorAdvogado": {
          "type": "boolean",
          "default": false
        },
        "rascunho": {
          "type": "boolean",
          "default": false
        },
        "ordem": {
          "type": "integer",
          "default": 99
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "titulo",
        "resumo",
        "respostaCurta",
        "frente",
        "publicadoEm"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}