APP_LEADS_URL=https://app.sindiops.com.br/api/leads
APP_LEADS_SECRET=

# Identificação do controlador dos dados — REDE DE SEGURANÇA, não fonte de
# verdade. A fonte é o app (`GET /api/controlador`, derivado de APP_LEADS_URL);
# estes valores só entram quando ele não responde, para que a página legal
# nunca deixe de identificar quem responde pelo tratamento dos dados.
# Mantenha-os iguais aos do app quando eles mudarem lá.
PUBLIC_LEGAL_NAME=
PUBLIC_LEGAL_CNPJ=
PUBLIC_LEGAL_ADDRESS=
PUBLIC_LEGAL_DPO_NAME=
PUBLIC_LEGAL_DPO_EMAIL=privacidade@sindiops.com.br
