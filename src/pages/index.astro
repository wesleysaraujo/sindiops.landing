    <script>
      // ---- 1. Varredura do grifo quando o documento entra na tela ----
      const grifos = document.querySelectorAll('.grifo-animado');
      if ('IntersectionObserver' in window && grifos.length > 0) {
        const observador = new IntersectionObserver(
          (entradas, obs) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('grifar');
                obs.unobserve(entrada.target);
              }
            }
          },
          { threshold: 0.6 }
        );
        grifos.forEach((el) => observador.observe(el));
      } else {
        grifos.forEach((el) => el.classList.add('grifar'));
      }

      // ---- 1b. Quem prefere menos movimento não recebe vídeo em loop ----
      // Ganha os controles no lugar: a demonstração continua disponível, mas
      // quem decide quando ela roda é a pessoa. Descarregar o vídeo (preload
      // 'none' + load) devolve o pôster à tela — parar em t=0 deixaria à mostra
      // o quadro do "Consultando...", que não conta nada de útil parado.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video[autoplay]').forEach((v) => {
          const video = v as HTMLVideoElement;
          video.removeAttribute('autoplay');
          video.controls = true;
          video.preload = 'none';
          video.pause();
          video.load();
        });
      } else {
        // ---- 1c. Autoplay que realmente começa ----
        // O atributo sozinho não basta: o vídeo está abaixo da dobra e o
        // navegador adia (ou recusa) o play de quem não está visível. O
        // observador dispara quando ele aparece; se a política do navegador
        // ainda assim recusar, os controles entram para a pessoa dar play em
        // vez de ficar com um pôster parado que parece imagem.
        document.querySelectorAll('video[autoplay]').forEach((v) => {
          const video = v as HTMLVideoElement;
          // Autoplay só é permitido sem som — e o vídeo não tem áudio.
          video.muted = true;

          const tocar = () => {
            video.play().catch(() => {
              video.controls = true;
            });
          };

          if ('IntersectionObserver' in window) {
            const obs = new IntersectionObserver(
              (entradas) => {
                for (const entrada of entradas) {
                  if (entrada.isIntersecting) tocar();
                }
              },
              { threshold: 0.25 }
            );
            obs.observe(video);
          } else {
            tocar();
          }
        });
      }

      // ---- 2. Máscara de WhatsApp: (21) 98765-4321 ----
      const campoWhats = document.getElementById('whatsapp') as HTMLInputElement | null;
      campoWhats?.addEventListener('input', () => {
        const d = campoWhats.value.replace(/\D/g, '').slice(0, 11);
        let mascarado = d;
        if (d.length > 2) mascarado = `(${d.slice(0, 2)}) ${d.slice(2)}`;
        if (d.length > 7) {
          const corte = d.length === 11 ? 7 : 6;
          mascarado = `(${d.slice(0, 2)}) ${d.slice(2, corte)}-${d.slice(corte)}`;
        }
        campoWhats.value = mascarado;
      });

      // ---- 2b. Ponte com o GTM ----
      // O GTM não enxerga nada disto sozinho: o envio é por fetch (não há
      // navegação para uma página de obrigado) e o gatilho nativo de vídeo do
      // GTM só entende YouTube. Cada `push` aqui vira um gatilho de evento
      // personalizado lá. O array é criado se ainda não existir — em `astro
      // dev` o GTM não carrega, e sem isto o push quebraria o script inteiro.
      type EventoRastreado = Record<string, unknown> & { event: string };

      function rastrear(evento: EventoRastreado) {
        const w = window as unknown as { dataLayer?: EventoRastreado[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push(evento);
      }

      // ---- 2c. Progresso do vídeo da demonstração ----
      // Quartis, uma vez cada: quem chega aos 50% viu a pergunta virar
      // resposta com o artigo citado, que é a prova que a página promete.
      document.querySelectorAll('video').forEach((v) => {
        const video = v as HTMLVideoElement;
        const marcosVistos = new Set<number>();

        video.addEventListener('timeupdate', () => {
          if (!video.duration || !isFinite(video.duration)) return;

          const percentual = (video.currentTime / video.duration) * 100;

          for (const marco of [25, 50, 75, 100]) {
            if (percentual >= marco && !marcosVistos.has(marco)) {
              marcosVistos.add(marco);
              rastrear({ event: 'video_progresso', marco_percentual: marco });
            }
          }
        });
      });

      // ---- 3. utm_source da query string ----
      const utm = new URLSearchParams(location.search).get('utm_source');
      const campoUtm = document.getElementById('utm_source') as HTMLInputElement | null;
      if (utm && campoUtm) campoUtm.value = utm.slice(0, 120);

      // ---- 4. Envio do formulário com validação em português ----
      const form = document.getElementById('form-waitlist') as HTMLFormElement | null;
      const botao = document.getElementById('botao-enviar') as HTMLButtonElement | null;

      const mensagens: Record<string, (v: string) => string | null> = {
        nome: (v) => (v.trim().length >= 2 ? null : 'Digite seu nome — é como vou te chamar no WhatsApp.'),
        whatsapp: (v) => {
          const d = v.replace(/\D/g, '');
          return d.length === 10 || d.length === 11 ? null : 'Digite o WhatsApp com DDD, no formato (21) 98765-4321.';
        },
        email: (v) =>
          /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())
            ? null
            : 'Confira o e-mail — precisa ter o formato nome@exemplo.com.br.',
        condominios: (v) => (v ? null : 'Escolha uma das quatro opções de quantidade.'),
      };

      function mostrarErro(campo: string, texto: string | null) {
        const el = document.getElementById(`erro-${campo}`);
        if (!el) return;
        if (texto) {
          el.textContent = texto;
          el.classList.remove('hidden');
        } else {
          el.textContent = '';
          el.classList.add('hidden');
        }
        const input = document.getElementById(campo);
        input?.setAttribute('aria-invalid', texto ? 'true' : 'false');
      }

      // Uma vez só: interessa saber quantos começam a preencher, não quantas
      // vezes a pessoa clicou de campo em campo.
      let inicioRegistrado = false;
      form?.addEventListener(
        'input',
        () => {
          if (inicioRegistrado) return;
          inicioRegistrado = true;
          rastrear({ event: 'form_start' });
        },
        { once: false }
      );

      form?.addEventListener('submit', async (evento) => {
        evento.preventDefault();
        const dados = new FormData(form);
        const valores = Object.fromEntries(dados.entries()) as Record<string, string>;

        let primeiroErro: string | null = null;
        for (const campo of ['nome', 'whatsapp', 'email', 'condominios']) {
          const erro = mensagens[campo](valores[campo] || '');
          mostrarErro(campo, erro);
          if (erro && !primeiroErro) primeiroErro = campo;
        }
        if (primeiroErro) {
          rastrear({ event: 'lead_erro', origem_erro: 'validacao', campo_erro: primeiroErro });
          const alvo = document.getElementById(primeiroErro) || document.getElementById('grupo-condominios');
          alvo?.scrollIntoView({ block: 'center', behavior: 'smooth' });
          (document.getElementById(primeiroErro) as HTMLElement | null)?.focus?.();
          return;
        }

        botao?.setAttribute('disabled', 'true');
        const erroGeral = document.getElementById('erro-geral');
        erroGeral?.classList.add('hidden');

        try {
          const resposta = await fetch('/waitlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(valores),
          });

          if (resposta.ok) {
            // A conversão. Vai com a faixa de condomínios e a origem para o
            // relatório dizer que tipo de síndico converte, e não só quantos.
            rastrear({
              event: 'lead_enviado',
              faixa_condominios: valores.condominios || null,
              origem: valores.utm_source || 'direto',
            });
            form.classList.add('hidden');
            const sucesso = document.getElementById('sucesso');
            sucesso?.classList.remove('hidden');
            (sucesso as HTMLElement | null)?.focus();
          } else if (resposta.status === 422) {
            const corpo = await resposta.json();
            for (const [campo, texto] of Object.entries(corpo.erros || {})) {
              mostrarErro(campo, texto as string);
            }
            rastrear({
              event: 'lead_erro',
              origem_erro: 'servidor',
              campo_erro: Object.keys(corpo.erros || {})[0] || null,
            });
          } else {
            throw new Error('erro-servidor');
          }
        } catch {
          rastrear({ event: 'lead_erro', origem_erro: 'rede', campo_erro: null });
          if (erroGeral) {
            erroGeral.textContent =
              'Não consegui enviar agora. Espere um instante e toque de novo no botão — seus dados continuam preenchidos.';
            erroGeral.classList.remove('hidden');
          }
        } finally {
          botao?.removeAttribute('disabled');
        }
      });
    </script>
  </body>
</html>
