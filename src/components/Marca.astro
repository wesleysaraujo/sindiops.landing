---
/**
 * A marca: a folha do documento com a lupa sobre o § da norma, mais o nome com
 * "Ops." em azul-caneta.
 *
 * Existe como componente porque estava escrita à mão na home e **abreviada**
 * nas outras páginas — termos, privacidade e guias traziam só "SindiOps", sem
 * o glifo e sem a cor. Quem chega a um guia pela busca vê a marca ali antes de
 * ver qualquer outra coisa do produto, e uma versão pela metade é pior que
 * nenhuma: parece outro site.
 *
 * O SVG é inline, e não `<img>`, para o azul sair de `--azul-caneta` — o mesmo
 * token da paleta. O `viewBox` recorta a margem morta do desenho original
 * (100×100 com o traço ocupando de 24 a 87), senão a marca renderiza pequena
 * dentro de uma caixa quase vazia.
 */
interface Props {
  /** `grande` na home; `padrao` no cabeçalho das páginas internas. */
  tamanho?: 'padrao' | 'grande';
  class?: string;
}

const { tamanho = 'padrao', class: classe = '' } = Astro.props;

const glifo = tamanho === 'grande' ? 'size-9' : 'size-7';
const texto = tamanho === 'grande' ? 'text-2xl' : 'text-xl';
---

<span class:list={['flex items-center gap-2.5', classe]}>
  <svg viewBox="18 14 76 76" fill="none" xmlns="http://www.w3.org/2000/svg" class:list={[glifo, 'shrink-0']} aria-hidden="true">
    <path d="M24 20C24 17.7909 25.7909 16 28 16H58L74 32V78C74 80.2091 72.2091 82 70 82H28C25.7909 82 24 80.2091 24 78V20Z" fill="var(--azul-caneta)" />
    <path d="M58 16V32H74" fill="#ffffff" opacity="0.35" />
    <rect x="32" y="27" width="16" height="4" rx="1" fill="#ffffff" />
    <rect x="32" y="35" width="22" height="4" rx="1" fill="#ffffff" />
    <rect x="32" y="43" width="12" height="4" rx="1" fill="#ffffff" />
    <circle cx="58" cy="58" r="18" fill="#ffffff" stroke="var(--azul-caneta)" stroke-width="6" />
    <text x="58" y="58" font-size="20" font-weight="bold" font-family="Georgia, 'Times New Roman', serif" fill="var(--azul-caneta)" text-anchor="middle" dominant-baseline="central">§</text>
    <path d="M71 71L84 84" stroke="var(--azul-caneta)" stroke-width="7" stroke-linecap="round" />
  </svg>

  <span class:list={['font-display font-extrabold tracking-tight text-tinta', texto]}>
    Sindi<span class="text-caneta">Ops</span><span class="text-caneta">.</span>
  </span>
</span>
