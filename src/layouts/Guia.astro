---
import '../styles/global.css';
import Marca from '../components/Marca.astro';
import { dataPorExtenso, type Guia } from '../lib/guias';

/**
 * A casca de um guia.
 *
 * Repete o cabeçalho e o rodapé de `Documento.astro` em vez de os dois
 * dividirem um terceiro layout: a semelhança é atual, não estrutural. Documento
 * legal carrega versão e vigência e é lido em diagonal atrás de uma cláusula;
 * guia carrega resposta curta e é lido do começo. Unificar agora criaria um
 * layout com dois modos, que é a forma de os dois piorarem juntos na primeira
 * mudança de um deles.
 */
interface Props {
  guia: Guia;
}

const { guia } = Astro.props;
const { titulo, resumo, respostaCurta, publicadoEm, revisadoEm } = guia.data;

const url = `https://www.sindiops.com.br/guias/${guia.id}`;
const atualizadoEm = revisadoEm ?? publicadoEm;

/**
 * `Article` com data de publicação e de revisão.
 *
 * A `description` é a **resposta curta**, não o resumo comercial: é o trecho
 * que um buscador — ou um assistente que responde citando fontes — recorta
 * para responder, e o que ele mostra ali decide se a pessoa clica.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: respostaCurta,
  url,
  inLanguage: 'pt-BR',
  datePublished: publicadoEm.toISOString().slice(0, 10),
  dateModified: atualizadoEm.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: 'SindiOps', url: 'https://www.sindiops.com.br' },
  publisher: { '@id': 'https://www.sindiops.com.br/#organizacao' },
  isPartOf: { '@type': 'WebSite', name: 'SindiOps', url: 'https://www.sindiops.com.br' },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titulo} — SindiOps</title>
    <meta name="description" content={resumo} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="article" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="SindiOps" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={resumo} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content="https://www.sindiops.com.br/img/og-sindiops.png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="SindiOps — trecho da convenção do condomínio grifado, com carimbo de versão vigente"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={resumo} />
    <meta name="twitter:image" content="https://www.sindiops.com.br/img/og-sindiops.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preload" href="/fonts/besley-v22-latin-800.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-v12-latin_latin-ext-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="bg-papel text-tinta font-corpo antialiased">
    <header class="border-b border-fiopapel">
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-5 md:px-8">
        <a href="/" aria-label="SindiOps, página inicial"><Marca /></a>
        <a href="/guias" class="text-[0.95rem] underline decoration-caneta decoration-2 underline-offset-2 text-tinta">
          Todos os guias
        </a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl px-5 py-12 md:px-8 md:py-16">
      <p class="font-protocolo text-[0.78rem] tracking-wide text-grafite uppercase">Guia do síndico</p>

      <h1 class="font-display mt-3 text-[2rem] font-bold text-balance md:text-[2.6rem]">{titulo}</h1>

      <!--
        A resposta curta antes de tudo. Quem chegou de uma busca veio atrás da
        resposta, não do percurso até ela — e se precisar rolar para achá-la,
        volta para o resultado seguinte.
      -->
      <div class="mt-8 border-l-[3px] border-caneta bg-white px-5 py-4">
        <p class="font-protocolo text-[0.72rem] tracking-wide text-grafite uppercase">Resposta curta</p>
        <p class="mt-2 text-[1.05rem] leading-relaxed">{respostaCurta}</p>
      </div>

      <div class="documento-legal mt-10">
        <slot />
      </div>

      <!--
        O aviso vai no fim e é o mesmo do produto: apoio à decisão, não parecer
        jurídico. Repetir aqui não é formalidade — este texto vai ser lido por
        quem está prestes a notificar um morador.
      -->
      <aside class="mt-12 border-t border-fiopapel pt-6 text-[0.95rem] text-grafite">
        <p>
          Este guia é <strong class="text-tinta">apoio à decisão</strong>, não parecer jurídico. A regra que vale no seu
          prédio é a da sua convenção e do seu regimento; para caso concreto, consulte o advogado do condomínio.
        </p>
        <p class="mt-3">
          Atualizado em {dataPorExtenso(atualizadoEm)}.
        </p>
      </aside>

      <div class="mt-10 border border-fiopapel bg-white p-6">
        <p class="font-display text-[1.2rem] font-bold">
          Quer a resposta com o artigo da <em>sua</em> convenção?
        </p>
        <p class="mt-2 text-[0.98rem] text-grafite">
          O SindiOps responde perguntas como esta lendo os documentos do seu condomínio, e cita o artigo, a página e o
          trecho original para você conferir antes de usar.
        </p>
        <a
          href="/#acesso"
          class="mt-5 inline-block bg-caneta px-5 py-3 font-bold text-papel"
        >
          Pedir acesso
        </a>
      </div>
    </main>

    <footer class="border-t border-fiopapel">
      <div
        class="mx-auto flex w-full max-w-3xl flex-col gap-4 px-5 py-10 text-[0.95rem] text-grafite md:flex-row md:items-center md:justify-between md:px-8"
      >
        <div>
          <Marca tamanho="padrao" />
          <p class="mt-1">Apoio à decisão do síndico. Não substitui orientação jurídica.</p>
        </div>

        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/guias" class="underline decoration-caneta decoration-2 underline-offset-2 text-tinta">Guias</a>
          <a href="/termos" class="underline decoration-caneta decoration-2 underline-offset-2 text-tinta">
            Termos de uso
          </a>
          <a href="/privacidade" class="underline decoration-caneta decoration-2 underline-offset-2 text-tinta">
            Privacidade
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
